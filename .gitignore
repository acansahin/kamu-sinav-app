# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# üretilmiş içerik — kaynak content/ altındadır, `npm run content:build` üretir
/public/content/

# dış inceleme için üretilen Markdown — `npm run review:export` üretir
/review/

# Playwright çıktıları
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Not: Android tarafının yok sayılanları android/.gitignore içinde tanımlıdır
# (kopyalanan web varlıkları, gradle çıktıları, local.properties). Burada
# tekrarlanmaz.

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...ama örnek dosya izlenir: hangi değişkenlerin gerektiğini o anlatıyor.
# İçinde yalnızca boş anahtar adları vardır, değer yoktur.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
